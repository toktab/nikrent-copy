# Local development environment variables
# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit real keys

# Supabase - Dashboard → Project Settings → API (or the Connect button).
# With both set, the app asks for a login and saves to the server; with either
# missing it runs offline from this browser's localStorage, with no login.
# Use the anon / publishable key, never service_role - the app refuses that one.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=


# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Optional — model used by the generate-algorithm function (default: gemini-3.1-pro-preview)
# Free-tier friendly: set GEMINI_MODEL=gemini-3.6-flash (lower quota pressure)
# GEMINI_MODEL=gemini-3.6-flash