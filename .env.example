# Copy to `.env.local` and fill in from Supabase → Settings → API.
# `.env.local` is gitignored; this file is the committed template and must
# never contain real values.
#
# Only the URL and the anon (publishable) key belong here. Both are visible in
# the browser bundle by design — row-level security is what protects the data.
# The `service_role` key bypasses every security rule and must never be used in
# the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
